# Supabase (separate project from the main storeshift.in site)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_SITE_URL=https://careers.storeshift.in
NEXT_PUBLIC_MAIN_SITE_URL=https://storeshift.in

# Email provider (pluggable — see src/lib/email/service.ts)
# Leave EMAIL_PROVIDER=console during development; it logs emails instead of sending them.
EMAIL_PROVIDER=console
EMAIL_FROM="StoreShift Careers <careers@storeshift.in>"

# --- Option A: SMTP (e.g. Gmail / Google Workspace) ---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=careers@storeshift.in
# # This must be a 16-character Google App Password, NOT your normal
# # account password — Gmail rejects plain-password SMTP auth entirely.
# # Requires 2-Step Verification to be on for this account first:
# # https://myaccount.google.com/apppasswords
# SMTP_PASSWORD=your-16-char-app-password

# --- Option B: Resend ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
